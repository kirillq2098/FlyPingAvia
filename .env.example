# Токен бота от @BotFather (допускается и TELEGRAM_TOKEN)
BOT_TOKEN=123456:REPLACE_ME
# TELEGRAM_TOKEN=

# Travelpayouts / Aviasales API (допускается и AVIASALES_API_TOKEN)
# Без токена бот работает в demo-режиме с синтетическими ценами
TRAVELPAYOUTS_TOKEN=
# AVIASALES_API_TOKEN=

# Маркер партнёрской ссылки Travelpayouts (для CPA)
AFFILIATE_MARKER=flypingavia

# Живой поиск за взрослых/детей (Flight Search API)
# Нужен доступ от Travelpayouts (письмо на support@travelpayouts.com)
# и обычно ЧИСЛОВОЙ partner ID из кабинета (не текстовый sub-marker).
# TRAVELPAYOUTS_SEARCH_MARKER=123456
# LIVE_SEARCH_MODE=off   # off | multi | always — пока off: нет доступа к Flight Search
# LIVE_SEARCH_HOST=flypingavia.app

# Лимит маршрутов на бесплатном тарифе (0 = без лимита)
FREE_WATCH_LIMIT=0

# Интервал проверки: минуты ИЛИ секунды (секунды имеют приоритет)
CHECK_INTERVAL_MINUTES=30
# CHECK_INTERVAL_SECONDS=1800

# БД: либо DATABASE_URL, либо DB_PATH
DATABASE_URL=sqlite+aiosqlite:///./data/flypingavia.db
# DB_PATH=data/avia_bot.sqlite3

# Валюта цен
CURRENCY=rub

# Антиспам алертов (NT-04): на один watch
# Повторный алерт — если прошли часы cooldown ИЛИ цена упала минимум на delta
NOTIFICATION_COOLDOWN_HOURS=24
MIN_PRICE_DELTA=500

# Telegram Mini App
# Публичный HTTPS URL (ngrok / cloudflared / VPS). Без него кнопка приложения скрыта.
WEBAPP_URL=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Для отладки UI в браузере без Telegram:
WEBAPP_DEV_USER_ID=
