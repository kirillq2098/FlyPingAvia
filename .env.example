# Режим: development | production | test
APP_ENV=development

# Токен бота от @BotFather (допускается и TELEGRAM_TOKEN)
BOT_TOKEN=123456:REPLACE_ME
# TELEGRAM_TOKEN=

# Travelpayouts / Aviasales API (допускается и AVIASALES_API_TOKEN)
# Без токена бот работает в demo-режиме с синтетическими ценами
TRAVELPAYOUTS_TOKEN=
# AVIASALES_API_TOKEN=

# Маркер партнёрской ссылки Travelpayouts (для CPA)
AFFILIATE_MARKER=flypingavia

# Живой поиск за взрослых/детей (Flight Search API)
# Нужен доступ от Travelpayouts (письмо на support@travelpayouts.com)
# и обычно ЧИСЛОВОЙ partner ID из кабинета (не текстовый sub-marker).
# TRAVELPAYOUTS_SEARCH_MARKER=123456
# LIVE_SEARCH_MODE=off   # off | multi | always — пока off: нет доступа к Flight Search
# LIVE_SEARCH_HOST=flypingavia.app

# Лимит маршрутов на бесплатном тарифе (0 = без лимита)
FREE_WATCH_LIMIT=0

# Интервал проверки: минуты ИЛИ секунды (секунды имеют приоритет)
CHECK_INTERVAL_MINUTES=30
# CHECK_INTERVAL_SECONDS=1800

# БД: либо DATABASE_URL, либо DB_PATH
DATABASE_URL=sqlite+aiosqlite:///./data/flypingavia.db
# DB_PATH=data/avia_bot.sqlite3

# Валюта цен
CURRENCY=rub

# Антиспам алертов (NT-04): на один watch
# Повторный алерт — если прошли часы cooldown ИЛИ цена упала минимум на delta
NOTIFICATION_COOLDOWN_HOURS=24
MIN_PRICE_DELTA=500

# Таймзона показа last_checked_at (БД хранит UTC). IANA, default Europe/Moscow
DISPLAY_TIMEZONE=Europe/Moscow

# Telegram Mini App — canonical публичный URL (без trailing /, path, query)
# development: можно оставить пустым или http://127.0.0.1:8080
# production: обязателен HTTPS, например https://app.example.com
WEBAPP_URL=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Uvicorn: IP reverse proxy, которому доверяем X-Forwarded-* (не *)
FORWARDED_ALLOW_IPS=127.0.0.1
# WEBAPP_DEV_USER_ID=
# Срок жизни Telegram WebApp initData (секунды, default 3600)
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
# Публичный username бота без @ (кнопка «Открыть бота» вне Telegram + deep links TG-03/04; опционально)
TELEGRAM_BOT_USERNAME=
# TG-04: срок жизни share-ссылки (часы, 1–720, default 168 = 7 дней)
WATCH_SHARE_TTL_HOURS=168
# TG-04: максимум успешных копий по одной ссылке (1–1000, default 20)
WATCH_SHARE_MAX_USES=20
# TG-04: HMAC secret для confirm callback (production: обязательно ≥32 символов; НЕ bot token)
WATCH_SHARE_CALLBACK_SECRET=
# TG-04: TTL подписанного confirm proof (секунды, 60–3600, default 900)
WATCH_SHARE_CALLBACK_TTL_SECONDS=900

# RL-03: служебные health-алерты администратору (пусто = отправка выключена)
ADMIN_TELEGRAM_CHAT_ID=
ADMIN_ALERTS_ENABLED=true
ADMIN_ALERT_FAILURE_THRESHOLD=3
ADMIN_ALERT_COOLDOWN_SECONDS=3600
HEALTH_MONITOR_INTERVAL_SECONDS=60
HEALTH_STARTUP_GRACE_SECONDS=300
# CHECKER_STALE_AFTER_SECONDS=  # default: max(check_interval*3, 900)
WEBAPP_HEALTHCHECK_TIMEOUT_SECONDS=5
# CSV user id для /admin_health (обязательно, если ADMIN_TELEGRAM_CHAT_ID — группа)
ADMIN_TELEGRAM_USER_IDS=

# Closed Beta Phase A (optional)
# BETA_ENABLED=true
# BETA_INVITE_CODES=w1
# BETA_SURVEY_A_DELAY_SECONDS=90
# BETA_DISPATCHER_INTERVAL_SECONDS=120
