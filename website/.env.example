# FlyPing — environment variables
# Copy to `.env.local` and fill in production values.

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://flyping.ru

# Telegram bot (product CTA)
# Native t.me deep-link with beta attribution payload (site1 = came from website).
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/FlyPingAvia_Bot?start=beta_site1
NEXT_PUBLIC_TELEGRAM_USERNAME=FlyPingAvia_Bot

# Support contact (legal pages; not the product bot)
NEXT_PUBLIC_SUPPORT_EMAIL=Q2098@yandex.ru
NEXT_PUBLIC_SUPPORT_TELEGRAM=https://t.me/Akulov_Kirill

# Analytics (leave empty to disable — currently unused)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YANDEX_METRICA_ID=
