[Unit]
Description=FlyPing production stack (Docker Compose)
Documentation=file:///opt/flyping/docs/PRODUCTION_RECOVERY.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/flyping
EnvironmentFile=-/opt/flyping/.env
# Idempotent: re-running up -d is safe when containers already run.
ExecStart=/usr/bin/docker compose -f /opt/flyping/docker-compose.prod.yml --env-file /opt/flyping/.env up -d
# Stop containers without removing them or volumes (no `down`).
ExecStop=/usr/bin/docker compose -f /opt/flyping/docker-compose.prod.yml --env-file /opt/flyping/.env stop
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
