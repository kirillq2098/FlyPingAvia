# Production environment example for Timeweb (IN-04).
# Copy to /opt/flyping/.env on the server, fill secrets locally, chmod 600.
# NEVER commit the real .env.

APP_ENV=production

# Telegram (required)
BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# BOT_USERNAME without @ — same as TELEGRAM_BOT_USERNAME if set in BotFather

# Travelpayouts (required for live prices; empty → DEMO_PRICES_ENABLED on /api/ready)
TRAVELPAYOUTS_TOKEN=
AFFILIATE_MARKER=flypingavia

# SQLite (default path inside container volume)
DB_PATH=/app/data/flypingavia.db
# DATABASE_URL=sqlite+aiosqlite:////app/data/flypingavia.db

CURRENCY=rub
CHECK_INTERVAL_MINUTES=30
FREE_WATCH_LIMIT=0
DISPLAY_TIMEZONE=Europe/Moscow
NOTIFICATION_COOLDOWN_HOURS=24
MIN_PRICE_DELTA=500

# Mini App / reverse proxy
WEBAPP_URL=https://app.flyping.ru
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
WEBAPP_DEV_USER_ID=0
FORWARDED_ALLOW_IPS=127.0.0.1
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600

# TG-04 share confirm (production: openssl rand -hex 32 → ≥32 chars; NOT bot token)
WATCH_SHARE_CALLBACK_SECRET=
WATCH_SHARE_TTL_HOURS=168
WATCH_SHARE_MAX_USES=20
WATCH_SHARE_CALLBACK_TTL_SECONDS=900

# RL-03 admin health alerts (optional)
ADMIN_TELEGRAM_CHAT_ID=
ADMIN_ALERTS_ENABLED=true
ADMIN_ALERT_FAILURE_THRESHOLD=3
ADMIN_ALERT_COOLDOWN_SECONDS=3600
HEALTH_MONITOR_INTERVAL_SECONDS=60
HEALTH_STARTUP_GRACE_SECONDS=300
ADMIN_TELEGRAM_USER_IDS=
